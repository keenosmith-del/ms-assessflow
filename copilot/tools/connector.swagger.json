{
  "swagger": "2.0",
  "info": {
    "title": "AssessFlow Employee Tools",
    "version": "1.0.0"
  },
  "host": "REPLACE_WITH_API_HOST",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "entraOAuth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/REPLACE_TENANT/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/REPLACE_TENANT/oauth2/v2.0/token",
      "scopes": {
        "Requests.Create": "Submit and clarify own access requests",
        "Requests.Read": "Read permitted request status",
        "Policies.Read": "Search permitted policy evidence"
      }
    }
  },
  "paths": {
    "/v1/tools/requests": {
      "post": {
        "operationId": "CreateAccessRequest",
        "summary": "Create Tool",
        "description": "Delegated employee tool; the backend enforces identity and ownership.",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "type": "string",
            "minLength": 8,
            "maxLength": 100
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RequestInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Persisted tool result",
            "schema": {
              "$ref": "#/definitions/ToolRequestResult"
            }
          }
        },
        "security": [
          {
            "entraOAuth": [
              "Requests.Create"
            ]
          }
        ]
      }
    },
    "/v1/tools/requests/{request_id}": {
      "get": {
        "operationId": "GetRequestStatus",
        "summary": "Status Tool",
        "description": "Delegated employee tool; the backend enforces identity and ownership.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted tool result",
            "schema": {
              "$ref": "#/definitions/ToolStatusResult"
            }
          }
        },
        "security": [
          {
            "entraOAuth": [
              "Requests.Read"
            ]
          }
        ]
      }
    },
    "/v1/tools/requests/{request_id}/information": {
      "patch": {
        "operationId": "SupplyRequestInformation",
        "summary": "Information Tool",
        "description": "Delegated employee tool; the backend enforces identity and ownership.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Clarification"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted tool result",
            "schema": {
              "$ref": "#/definitions/ToolRequestResult"
            }
          }
        },
        "security": [
          {
            "entraOAuth": [
              "Requests.Create"
            ]
          }
        ]
      }
    },
    "/v1/tools/policies/search": {
      "get": {
        "operationId": "SearchPermittedPolicies",
        "summary": "Search Tool",
        "description": "Delegated employee tool; the backend enforces identity and ownership.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "type": "string",
            "default": ""
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted tool result",
            "schema": {
              "$ref": "#/definitions/ToolSearchResult"
            }
          }
        },
        "security": [
          {
            "entraOAuth": [
              "Policies.Read"
            ]
          }
        ]
      }
    }
  },
  "definitions": {
